# PLEX PX-W3U4向けの設定です
# お使いのチューナーに合わせて変更してください

  - name: 'PLEX PX-W3U4 (Terrestrial) #1'
    types:
      - GR
    command: recisdb tune --device /dev/px4video2 -c T<channel> -
    decoder: ~
    isDisabled: false
  - name: 'PLEX PX-W3U4 (Terrestrial) #2'
    types:
      - GR
    command: recisdb tune --device /dev/px4video3 -c T<channel> -
    decoder: ~
    isDisabled: false
  - name: 'PLEX PX-W3U4 (Satellite) #1'
    types:
      - BS
      - CS
    command: recisdb tune --device /dev/px4video0 -c <channel> -
    decoder: ~
    isDisabled: false
  - name: 'PLEX PX-W3U4 (Satellite) #2'
    types:
      - BS
      - CS
    command: recisdb tune --device /dev/px4video1 -c <channel> -
    decoder: ~
    isDisabled: false
